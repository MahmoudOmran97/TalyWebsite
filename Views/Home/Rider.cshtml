@using System.Globalization
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    var isEnglish = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en";
    ViewData["Title"] = Localizer["RiderTitle"];
    var message = isEnglish ? "I would like to join Taly as a delivery rider" : "أرغب في الانضمام كطيار توصيل مع تطبيق تالي";
}
<div class="container py-5" style="max-width: 800px;">
    <div class="card border-0 shadow-sm p-5 rounded-4 text-center">
        <h1 class="fw-bold mb-3" style="color: var(--secondary-color);">@Localizer["RiderTitle"]</h1>
        @if (isEnglish)
        {
            <p class="text-muted mb-4">Work flexibly and increase your daily income by joining Taly's delivery team.</p>
            <div class="p-4 bg-light rounded-4 mb-4 text-start"><h5 class="fw-bold mb-3">Benefits of working with us</h5><ul class="mb-0"><li>Flexible hours that fit your schedule.</li><li>Competitive earnings and incentives for each delivery.</li><li>Technical support and smart directions through the app.</li></ul></div>
        }
        else
        {
            <p class="text-muted mb-4">اعمل بمرونة وزِد دخلك اليومي من خلال الانضمام إلى فريق التوصيل الخاص بتطبيق تالي.</p>
            <div class="p-4 bg-light rounded-4 mb-4 text-start"><h5 class="fw-bold mb-3">مميزات العمل معنا</h5><ul class="mb-0"><li>ساعات عمل مرنة تناسب جدولك اليومي.</li><li>أرباح وحوافز مجزية على كل طلب توصيل.</li><li>دعم فني وتوجيه ذكي عبر التطبيق.</li></ul></div>
        }
        <a href="https://wa.me/201000000000?text=@Uri.EscapeDataString(message)" target="_blank" rel="noopener" class="btn btn-download btn-lg px-5">@Localizer["ContactViaWhatsApp"]</a>
    </div>
</div>
